FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
ENV DATABASE_PATH=/tmp/timetone-release-build.db
RUN npm test && npm run lint && npm run build
RUN cp -a .next/static .next/standalone/.next/static && cp -a public .next/standalone/public
FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV DATABASE_PATH=/data/timekeep.db
ENV HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
RUN mkdir -p /data
EXPOSE 3000
CMD ["node", "server.js"]

FROM scratch AS artifact
COPY --from=build /app/.next/standalone /standalone
